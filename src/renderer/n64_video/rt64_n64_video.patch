+uint ViDitherValue(int2 pixel) {
+    const uint index = ((uint(pixel.y) & 3) << 2) | (uint(pixel.x) & 3);
+    return (gConstants.ditherPattern == 1) ? ViDitherBayer[index] : ViDitherMagicSquare[index];
